generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  HOD
  ADMIN
}

enum ItemStatus {
  LOST
  FOUND
  MATCHED
  READY_FOR_COLLECTION
  COLLECTED
  CLOSED
}

enum MatchStatus {
  PENDING
  CONFIRMED
  COLLECTED
  REJECTED
}

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String         @unique
  studentId     String         @unique
  role          Role           @default(STUDENT)
  createdAt     DateTime       @default(now())
  lostItems     LostItem[]
  foundItems    FoundItem[]
  notifications Notification[]
  @@map("users")
}

model LostItem {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  userId          String     @db.ObjectId
  name            String
  category        String
  brand           String?
  color           String?
  description     String
  dateLost        DateTime
  timeLost        String?
  locationLost    String
  imageUrl        String?
  identifyingInfo String?
  status          ItemStatus @default(LOST)
  createdAt       DateTime   @default(now())
  user            User       @relation(fields: [userId], references: [id])
  matches         Match[]
  @@index([userId])
  @@index([category, status])
  @@map("lost_items")
}

model FoundItem {
  id                  String     @id @default(auto()) @map("_id") @db.ObjectId
  userId              String     @db.ObjectId
  imageUrl            String
  itemType            String
  category            String
  brand               String?
  color               String?
  model               String?
  visibleText         String?
  description         String
  distinctiveFeatures String?
  condition           String?
  foundDate           DateTime
  foundTime           String?
  foundLocation       String
  notes               String?
  status              ItemStatus @default(FOUND)
  createdAt           DateTime   @default(now())
  user                User       @relation(fields: [userId], references: [id])
  matches             Match[]
  @@index([userId])
  @@index([category, status])
  @@map("found_items")
}

model Match {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  lostItemId       String      @db.ObjectId
  foundItemId      String      @db.ObjectId
  confidence       Int
  reason           String
  matchingFeatures String[]
  status           MatchStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  lostItem         LostItem    @relation(fields: [lostItemId], references: [id])
  foundItem        FoundItem   @relation(fields: [foundItemId], references: [id])
  notifications    Notification[]
  @@index([lostItemId])
  @@index([foundItemId])
  @@map("matches")
}

model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  matchId   String?   @db.ObjectId
  title     String
  message   String
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  match     Match?    @relation(fields: [matchId], references: [id])
  @@index([userId, read])
  @@map("notifications")
}
